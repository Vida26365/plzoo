# Mixed linear types

# For commenting use #.

# For removing ! use ^. It turns an expression of type !A into an expression of type A.
# When it is possible, an expression will have a type !A. 
# For example f uses no linear resources from the surrounding context, so it has a type !(Int -o Int):

let f = fun y : Int -> y + 1

let x  = 5
let z = ^x

f
f z
f ^x
x


# For breaking up lines use \

# Arrays.

let arr = [1, 2, 3, 4]
let len_and_arr = length arr
let arr = match len_and_arr with (l, a) -> \
    match swap a (l - 1) 100 with (v, a) -> a
arr


# Pair type.

let int_and_arr = (100, [1, 2, 3])
match int_and_arr with (v, a) -> swap a 2 v


# When using a sum type (A + B) you must define what type each side has.

let s = (inl 3 : !Int + !Int)
match s with inl x -> 1 | inr y -> 2


# With type.

let a = [1, 2, 3, 4]

let with_structure = a & (swap a 0 100)

snd with_structure

# Functions.

let f = fun x : !Int -> x + 1
f 3

# Recursive functions.
# A function of type !(A -o B) can be recursive.

let rec f from !Int to Int = \
    fun x : !Int -> \
        if x = 10 then ^x \
        else f (x + 1)

f 1


# If-then-else.
# Each branch of an if-then-else expression should use exactly the same linear resources.

let a = [1, 2, 3, 4]
let c = 1

if c < 10 then a else match swap a 0 100 with (v, a) -> a

# Comparing.
# You can use < between numbers and = with most types.

let a = [1, 2, 3]
a = [1, 2, 3]

(1, 2) = (3, 2)

(inl ^3 : Int + Int) = (inl ^3 : Int + Int)


# Example programs.

let option_find = fun a : Array !Int -> fun i : !Int -> \
        match (length a) with (l, a) -> \
            if i < l \
            then (inl (lookup a i) : (!Int * Array !Int) +  Array !Int) \
            else (inr a : (!Int * Array !Int) +  Array !Int)


let a = [1, 2, 3, 4]
let option = option_find a 100

match option with \
    inl int_and_arr -> (match int_and_arr with (i, arr) -> arr) | inr arr -> arr







