
let pair = (42, 420);
let second_pair = (21, pair);

let sumed = split second_pair to a b in a + split b to c d in c + d;
sumed;


let resource = 1;

let with_pair = (resource + 2) & (resource + 3);
snd with_pair;


let sumT : Int + Int * Int = if 5 < 6 then inl 1 else inr (2, 3);

match sumT with inl x = x | inr pair = (split pair to a b in a*b);


let f = lambda x : Bool in if x then 1 else 0;

f true;




