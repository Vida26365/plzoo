let f = open "files_reopen.tmp";
let f = write f "old";
close f;

# open keeps the contents, so they can be read. The first write then replaces them.
let f = open "files_reopen.tmp";
let p = read f;
match p with (s, f) ->
  match read (write f "new") with (t, f) ->
    let u = close f in s ^ " -> " ^ t;
